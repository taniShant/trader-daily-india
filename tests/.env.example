# AWS Configuration
AWS_REGION=eu-west-2
ENVIRONMENT=dev

# Trading Parameters
PAPER_TRADING=true
CAPITAL=100000
ANALYSIS_INTERVAL_SECONDS=180
MARKET_CLOSED_POLL_SECONDS=60
MIN_CONFIDENCE_THRESHOLD=70
MAX_DAILY_LOSS_PERCENT=4
MAX_POSITION_SIZE_PERCENT=10
WATCHLIST_SIZE=10
MICRO_SCAN_INTERVAL_SECONDS=30
MICRO_EXIT_CHECK_INTERVAL_SECONDS=30
MICRO_REENTRY_COOLDOWN_SECONDS=300
MICRO_CONTINUATION_TARGET_PCT=0.003
MICRO_CONTINUATION_MAX_HOLD_MINUTES=6
MICRO_EARLY_EXIT_ENABLED=true
MICRO_INVALIDATION_MIN_HOLD_SECONDS=120
MICRO_LOSS_THROTTLE_COUNT=2
MICRO_LOSS_THROTTLE_WINDOW_MINUTES=30
MICRO_MAX_CONTINUATION_VWAP_EXTENSION_ATR=2
MICRO_PULLBACK_MIN_IMPULSE_EXTENSION_ATR=2
MICRO_PULLBACK_MAX_ENTRY_EXTENSION_ATR=1.1
MICRO_PULLBACK_MIN_RELATIVE_VOLUME=1.2
MICRO_COST_SLIPPAGE_BPS=1
MICRO_SETUP_LOSS_THROTTLE_COUNT=2
MICRO_SETUP_LOSS_THROTTLE_MIN_TRADES=2
POSITION_RECONCILIATION_ENABLED=true
RUN_STARTUP_OVERNIGHT_ANALYSIS=false

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_FAST_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
