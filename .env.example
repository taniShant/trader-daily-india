# Local development environment template.
# Copy to .env for local Docker/test runs.
# AWS/CDK environment-specific infrastructure values live in env/prod.json.

ENVIRONMENT=prod
AWS_REGION=eu-west-2
BEDROCK_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_FAST_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_DEEP_RESEARCH_MODEL_ID=anthropic.claude-3-opus-20240229-v1:0

PAPER_TRADING=true
CAPITAL=10000000
ANALYSIS_INTERVAL_SECONDS=180
MARKET_CLOSED_POLL_SECONDS=60
MIN_CONFIDENCE_THRESHOLD=70
MAX_DAILY_LOSS_PERCENT=4
MAX_POSITION_SIZE_PERCENT=10
MAX_QUANTITY_PER_ORDER=5000
WATCHLIST_SIZE=10
ALPHA_UNIVERSE_SIZE=50
DEEP_ANALYSIS_SIZE=8
ALPHA_SCAN_WORKERS=8
MICRO_TRADING_ENABLED=false
MICRO_SCAN_INTERVAL_SECONDS=30
MICRO_EXIT_CHECK_INTERVAL_SECONDS=30
MICRO_MAX_HOLD_MINUTES=10
MICRO_MIN_CONFIDENCE=72
MICRO_MIN_RELATIVE_VOLUME=1.5
MICRO_MAX_SYMBOLS_PER_CYCLE=40
MICRO_REENTRY_COOLDOWN_SECONDS=300
MICRO_DIAGNOSTIC_TOP_N=5
MICRO_CONTINUATION_TARGET_PCT=0.003
MICRO_CONTINUATION_STOP_PCT=0.0015
MICRO_CONTINUATION_MAX_HOLD_MINUTES=6
MICRO_VWAP_TARGET_PCT=0.0035
MICRO_VWAP_STOP_PCT=0.0018
MICRO_VWAP_MAX_HOLD_MINUTES=8
MICRO_OPENING_RANGE_TARGET_PCT=0.005
MICRO_OPENING_RANGE_STOP_PCT=0.0025
MICRO_OPENING_RANGE_MAX_HOLD_MINUTES=10
MICRO_EARLY_EXIT_ENABLED=true
MICRO_INVALIDATION_MIN_HOLD_SECONDS=120
MICRO_LOSS_THROTTLE_COUNT=2
MICRO_LOSS_THROTTLE_WINDOW_MINUTES=30
MICRO_COST_BROKERAGE_BPS=1
MICRO_COST_TAXES_BPS=2
MICRO_COST_SLIPPAGE_BPS=2
MICRO_MIN_EXPECTED_NET_PROFIT=1000
MICRO_MIN_EXPECTED_NET_PROFIT_BPS=8
MICRO_MIN_TARGET_TO_COST_RATIO=1.4
POSITION_RECONCILIATION_ENABLED=true
RUN_STARTUP_OVERNIGHT_ANALYSIS=false

SESSIONS_TABLE=svc-trd-sessions-dev
TRADES_TABLE=svc-trd-trades-dev
LEARNING_TABLE=svc-trd-learning-dev
MARKET_STATE_TABLE=svc-trd-market-state-dev
SIGNALS_TABLE=svc-trd-signals-dev
RISK_EVENTS_TABLE=svc-trd-risk-events-dev
ORDERS_TABLE=svc-trd-orders-dev
FILLS_TABLE=svc-trd-fills-dev
POSITIONS_TABLE=svc-trd-positions-dev

# Oracle static-IP execution proxy.
ORACLE_STATIC_IP=80.225.242.6
ORACLE_EXECUTION_PROXY_BASE_URL=http://80.225.242.6:8080
ORACLE_EXECUTION_PROXY_HEALTH_URL=http://80.225.242.6:8080/health
ORACLE_COLLECTOR_BASE_URL=http://80.225.242.6:8090
ORACLE_COLLECTOR_HEALTH_URL=http://80.225.242.6:8090/health
ORACLE_PROXY_MODE=mock
ORACLE_PROXY_SHARED_SECRET=Tript!r0y
ORACLE_PROXY_CLIENT_ID=aws-trading-bot
ORACLE_PROXY_MAX_SKEW_SECONDS=300

# ICICI Breeze credentials.
ICICI_API_KEY=
ICICI_SECRET_KEY=
ICICI_SESSION_TOKEN=
ICICI_STATIC_IP=80.225.242.6

# Optional data APIs.
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
