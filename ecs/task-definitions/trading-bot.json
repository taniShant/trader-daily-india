{
  "family": "trd-bot",
  "executionRoleArn": "PLACEHOLDER_EXECUTION_ROLE_ARN",
  "taskRoleArn": "PLACEHOLDER_EXECUTION_ROLE_ARN",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "trd-bot",
      "image": "PLACEHOLDER_IMAGE",
      "essential": true,
      "command": ["python", "-c", "from agent.main import TradingBot; TradingBot().run()"],
      "environment": [
        {"name": "AWS_REGION", "value": "PLACEHOLDER_REGION"},
        {"name": "ENVIRONMENT", "value": "PLACEHOLDER_ENV"},
        {"name": "PAPER_TRADING", "value": "PLACEHOLDER_PAPER_TRADING"},
        {"name": "CAPITAL", "value": "PLACEHOLDER_CAPITAL"},
        {"name": "ANALYSIS_INTERVAL_SECONDS", "value": "PLACEHOLDER_ANALYSIS_INTERVAL"},
        {"name": "MIN_CONFIDENCE_THRESHOLD", "value": "PLACEHOLDER_MIN_CONFIDENCE"},
        {"name": "MAX_DAILY_LOSS_PERCENT", "value": "PLACEHOLDER_MAX_DAILY_LOSS"},
        {"name": "MAX_POSITION_SIZE_PERCENT", "value": "PLACEHOLDER_MAX_POSITION_SIZE"},
        {"name": "WATCHLIST_SIZE", "value": "PLACEHOLDER_WATCHLIST_SIZE"},
        {"name": "BEDROCK_MODEL_ID", "value": "PLACEHOLDER_BEDROCK_MODEL"},
        {"name": "BEDROCK_REGION", "value": "PLACEHOLDER_BEDROCK_REGION"},
        {"name": "STATIC_IP", "value": "PLACEHOLDER_STATIC_IP"},
        {"name": "SESSIONS_TABLE", "value": "PLACEHOLDER_SESSIONS_TABLE"},
        {"name": "TRADES_TABLE", "value": "PLACEHOLDER_TRADES_TABLE"},
        {"name": "LEARNING_TABLE", "value": "PLACEHOLDER_LEARNING_TABLE"},
        {"name": "MARKET_STATE_TABLE", "value": "PLACEHOLDER_MARKET_STATE_TABLE"},
        {"name": "CODE_BUCKET", "value": "PLACEHOLDER_CODE_BUCKET"} 
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trading-bot-PLACEHOLDER_ENV",
          "awslogs-region": "PLACEHOLDER_REGION",
          "awslogs-stream-prefix": "trading"
        }
      },
      "portMappings": [{"containerPort": 9090, "protocol": "tcp"}]
    }
  ]
}